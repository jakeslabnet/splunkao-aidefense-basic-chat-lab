{
  "name": "agentcore-chat-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "build": "python3 scripts/build.py",
    "deploy": "node scripts/lab.mjs deploy",
    "set-model": "node scripts/lab.mjs set-model",
    "publish": "node scripts/lab.mjs publish",
    "status": "node scripts/lab.mjs status",
    "cleanup": "node scripts/lab.mjs cleanup",
    "test:infra": "node --import tsx --test tests/infra.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.0.0",
    "@aws-sdk/client-cloudfront": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1155.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
